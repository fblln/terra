[
  {
    "id": "sim-tab",
    "type": "tab",
    "label": "simulator",
    "disabled": false,
    "info": "Answers traffic from the rules a test registered, and publishes the event a rule asked for, after the delay it asked for. All logic is in /data/simulator.js."
  },
  {
    "id": "sim-in",
    "type": "http in",
    "z": "sim-tab",
    "name": "any POST",
    "url": "/*",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 120,
    "y": 120,
    "wires": [["sim-handle"]]
  },
  {
    "id": "sim-in-get",
    "type": "http in",
    "z": "sim-tab",
    "name": "any GET",
    "url": "/*",
    "method": "get",
    "upload": false,
    "swaggerDoc": "",
    "x": 120,
    "y": 180,
    "wires": [["sim-handle"]]
  },
  {
    "id": "sim-handle",
    "type": "function",
    "z": "sim-tab",
    "name": "admin + match",
    "func": "return global.get('sim').handle(msg);",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 300,
    "y": 120,
    "wires": [["sim-out"], ["sim-delay"]]
  },
  {
    "id": "sim-out",
    "type": "http response",
    "z": "sim-tab",
    "name": "answer",
    "statusCode": "",
    "headers": {},
    "x": 500,
    "y": 80,
    "wires": []
  },
  {
    "id": "sim-delay",
    "type": "delay",
    "z": "sim-tab",
    "name": "as the rule asked",
    "pauseType": "delayv",
    "timeout": "5",
    "timeoutUnits": "seconds",
    "rate": "1",
    "nbRateUnits": "1",
    "rateUnits": "second",
    "randomFirst": "1",
    "randomLast": "5",
    "randomUnits": "seconds",
    "drop": false,
    "allowrate": false,
    "outputs": 1,
    "x": 500,
    "y": 180,
    "wires": [["sim-publish"]]
  },
  {
    "id": "sim-publish",
    "type": "http request",
    "z": "sim-tab",
    "name": "publish",
    "method": "POST",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 700,
    "y": 180,
    "wires": [["sim-log"]]
  },
  {
    "id": "sim-log",
    "type": "debug",
    "z": "sim-tab",
    "name": "publish result",
    "active": true,
    "tosidebar": false,
    "console": true,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 900,
    "y": 180,
    "wires": []
  }
]
